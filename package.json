{
  "name": "@huai_xin/dsh-model-picker",
  "version": "0.4.2",
  "description": "A searchable, provider-grouped replacement for the DSH composer's model picker.",
  "type": "module",
  "license": "MIT",
  "author": "huai_xin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2424830124/dsh-model-picker.git"
  },
  "homepage": "https://github.com/2424830124/dsh-model-picker#readme",
  "bugs": {
    "url": "https://github.com/2424830124/dsh-model-picker/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "model-picker",
    "composer"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "package.json",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "docs/*.png"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node test/unit/client.mjs",
    "prepublishOnly": "node scripts/build.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
